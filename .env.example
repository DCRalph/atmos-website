# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL="postgresql://user:password@localhost:5432/db"

# SMTP
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="user"
SMTP_PASS="password"
SMTP_FROM="noreply@atmos.com"
SMTP_SECURE="false"

# Shopify Storefront API (admin sync → DB cache; public merch reads cache)
SHOPIFY_STORE_DOMAIN="your-shop.myshopify.com"
SHOPIFY_PRIVATE_ACCESS_TOKEN="optional-admin-or-other-api-token"
NEXT_PUBLIC_SHOPIFY_PUBLIC_ACCESS_TOKEN="your-storefront-access-token"
# Optional: limit sync to a collection (omit to sync all products)
SHOPIFY_COLLECTION_HANDLE="summer-drop"

# --- Ticketing -------------------------------------------------------------

# Stripe (test keys locally, live keys in production)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Signs ticket QR payloads. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating this invalidates every live ticket and wallet pass.
TICKET_QR_SECRET=""

# Resend — transactional ticket email
RESEND_API_KEY="re_..."
RESEND_FROM="Atmos Tickets <tickets@atmosmedia.co.nz>"

# Apple Wallet
# Export the Pass Type ID certificate from Keychain as a .p12, then:
#   openssl pkcs12 -in pass.p12 -clcerts -nokeys -out signerCert.pem -legacy
#   openssl pkcs12 -in pass.p12 -nocerts -out signerKey.pem -legacy
#   curl -o wwdr.cer https://www.apple.com/certificateauthority/AppleWWDRCAG4.cer
#   openssl x509 -inform DER -in wwdr.cer -out wwdr.pem
# then base64 each PEM (base64 -w0 signerCert.pem)
APPLE_PASS_TYPE_ID="pass.nz.co.atmosmedia.ticket"
APPLE_TEAM_ID=""
APPLE_PASS_CERT_PEM_BASE64=""
APPLE_PASS_KEY_PEM_BASE64=""
APPLE_PASS_KEY_PASSWORD=""
APPLE_WWDR_PEM_BASE64=

# Google Wallet
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=""

# Shared secret for the Vercel cron endpoints
CRON_SECRET=""
