{
  "name": "atmos-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "prisma generate && next build",
    "check": "prisma generate && eslint . && node node_modules/@typescript/native/bin/tsc --noEmit",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:backfill-verified": "bun prisma/backfill-email-verified.ts",
    "db:seed": "bun prisma/seed.ts",
    "db:seed-themes": "bun prisma/seed-themes.ts",
    "db:studio": "prisma studio",
    "dev": "next dev",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "prisma generate && next build && next start",
    "start": "next start",
    "test": "bun test",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "ui:audit": "node scripts/ui-audit-creator.mjs",
    "refresh-baseline-browser-mapping": "bun i --save-dev baseline-browser-mapping@latest"
  },
