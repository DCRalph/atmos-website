model ActivityLog {
  id           String       @id @default(cuid())
  type         ActivityType
  action       String // Human-readable action description
  details      String? // JSON string with additional details
  userId       String? // User who performed the action
  targetUserId String? // User who was affected (if applicable)
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime     @default(now())

  // Relations
  user       User? @relation("UserActivities", fields: [userId], references: [id], onDelete: SetNull)
  targetUser User? @relation("TargetUserActivities", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([targetUserId])
  @@index([type])
  @@index([createdAt])
  @@map("activity_log")
}

model KeyValueStore {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@map("key_value_store")
}

// ---------------------------------------------------------------------------
// Ticketing
//
// Money is stored as integer cents throughout — deliberately different from the
// `Float` columns on the gear/rental models. This system issues GST receipts,
// and float drift in a tax figure is not acceptable.
//
// Prices are GST-INCLUSIVE, which is what NZ consumers must be shown. The GST
// component of a GST-inclusive total is `total * 3 / 23`.
// ---------------------------------------------------------------------------

enum TicketEventStatus {
  DRAFT
  PUBLISHED
  SALES_PAUSED
  SOLD_OUT
  CANCELLED
  ARCHIVED
}

/// Who is allowed to know an event exists.
///
/// Deliberately independent of `TicketEventStatus`: status says whether
/// tickets are on sale, this says who can find the page. A private event still
/// moves DRAFT → PUBLISHED → SOLD_OUT like any other, it just never appears in
/// a listing.
enum TicketEventVisibility {
  /// Listed on /events and on its linked gig.
  PUBLIC
  /// Listed nowhere, but the URL works for anyone who has it.
  UNLISTED
  /// Listed nowhere, and the URL only opens with the event's access key on it.
  /// This is the one you send to a guest list.
  PRIVATE
}

enum TicketOrderStatus {
  /// Inventory is held, payment not yet confirmed. Expires at `expiresAt`.
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  /// Free tier that requires admin approval before tickets are issued.
  AWAITING_APPROVAL
}

enum TicketStatus {
  VALID
  VOID
  REFUNDED
}

enum TicketScanResult {
  ADMITTED
  DUPLICATE
  OVERRIDE_ADMITTED
  REENTRY
  /// A manager undoing a mistaken admission. The scan log stays append-only,
  /// so an undo is a new row rather than a deletion.
  ADMISSION_REVERTED
  /// Door staff turned this person away after the scan itself came back fine.
  /// Carries `denyReason` and optionally `denyNote`.
  DENIED
  /// A later scan of a ticket that still carries an active denial. The door
  /// sees the earlier refusal instead of a fresh decision.
  PREVIOUSLY_DENIED
  INVALID_SIGNATURE
  NOT_FOUND
  WRONG_EVENT
  VOIDED
  REFUNDED_TICKET
  ORDER_UNPAID
}

/// What a ticket gets you past.
///
/// Read off the scan by whoever is handing out wristbands, so it is a short
/// fixed list everyone on a door already recognises rather than free text. A
/// tier carries the level it sells, and each issued ticket snapshots it — an
/// artist's guest can be bumped to AAA without rewriting the tier they came
/// from, and changing a tier later never silently re-bands tickets already in
/// people's pockets.
/// A door access level, editable by an organiser.
///
/// Replaces what used to be the `TicketAccessLevel` enum. `code` is what sits
/// on every ticket and is seeded with the old enum's exact values, so the
/// conversion was an identity mapping and historical tickets read unchanged.
/// Codes are immutable once issued; labels, colours and order are not.
model AccessLevel {
  /// Stored on tickets. Uppercase, no spaces.
  code  String @id
  label String
  /// Compact form for door badges and the wallet chip — `GA`, `AAA`.
  short String

  /// Tailwind pair for web badges. Solid, because a door badge sits on top of
  /// green, amber or red and has to stay readable on all three.
  tone String @default("bg-white text-black")

  /// Hex the wallet pass tints itself with. Null leaves the event's own theme
  /// alone, which is what general admission wants.
  passAccent String?

  /// Least to most access. Drives ordering everywhere and how far the accent
  /// floods a pass's band.
  rank Int @default(0)

  /// Retired levels stay so historical tickets still resolve, but are not
  /// offered when issuing anything new.
  archived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tiers   TicketTier[]
  tickets Ticket[]

  @@index([archived, rank])
  @@map("access_level")
}

enum TicketAccessLevel {
  GENERAL
  GUEST
  VIP
  ARTIST
  CREW
  AAA
}

/// Why the door turned someone away. A fixed list rather than free text: the
/// reasons have to be tappable one-handed in the dark, and they only mean
/// anything afterwards if everyone picked from the same set.
enum TicketDenyReason {
  INTOXICATED
  NO_ID
  UNDERAGE
  BEHAVIOUR
  DRESS_CODE
  BANNED
  WRONG_PERSON
  OTHER
}

enum DiscountCodeType {
  PERCENT
  FIXED
}

enum PaymentMethodKind {
  STRIPE
  CASH
  /// An external eftpos machine. The sale is only *recorded* here — the money
  /// moved before anybody pressed a button.
  TERMINAL
  /// Contactless taken on the staff member's own iPhone, through Stripe
  /// Terminal. Distinct from TERMINAL because the money moves inside our flow
  /// and can decline, and distinct from STRIPE so door card takings stay
  /// separable from online sales in reporting.
  TAP_TO_PAY
  COMP
  FREE
}

enum TicketEmailType {
  CONFIRMATION
  RESEND
  REFUND
  DETAILS_NUDGE
  REMINDER
  APPROVAL_REQUIRED
  COMP
  HANDOUT
}

enum EventStaffRole {
  SCANNER
  MANAGER
}

model TicketEvent {
  id   String @id @default(cuid())
  slug String @unique
  name String

  gigId String?
  gig   Gig?    @relation(fields: [gigId], references: [id], onDelete: SetNull)

  shortDescription   String?
  descriptionLexical Json?
  posterFileUploadId String?

  venueName    String?
  venueAddress String?
  timezone     String    @default("Pacific/Auckland")
  doorsAt      DateTime?
  startsAt     DateTime
  endsAt       DateTime?

  status       TicketEventStatus @default(DRAFT)
  publishedAt  DateTime?
  salesOpenAt  DateTime?
  salesCloseAt DateTime?

  visibility TicketEventVisibility @default(PUBLIC)
  accessKey  String?

  capacity             Int?
  compAllowance        Int?
  maxTicketsPerOrder   Int     @default(10)
  requireAttendeeNames Boolean @default(true)
  reentryAllowed       Boolean @default(false)
  isR18                Boolean @default(true)

  bookingFeeFixedCents Int?
  bookingFeePercentBp  Int?
  gstRateBp            Int     @default(1500)
  gstNumber            String?

  termsVersion String @default("v1")

  /// Apple Wallet pass styling. Null anywhere falls back to the Atmos default
  /// in `~/lib/ticketing/pass-theme.ts` — an event that sets nothing still gets
  /// a house-style pass.
  passStripStyle    PassStripStyle @default(HATCH)
  passAccentHex     String?
  passBackgroundHex String?
  passForegroundHex String?
  passLabelHex      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tiers         TicketTier[]
  orders        TicketOrder[]
  tickets       Ticket[]
  scans         TicketScan[]
  staff         TicketEventStaff[]
  discountCodes DiscountCode[]

  @@index([status, startsAt])
  @@index([gigId])
  @@index([posterFileUploadId])
  @@map("ticket_event")
}

model TicketTier {
  id      String      @id @default(cuid())
  eventId String
  event   TicketEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name        String
  description String?
  priceCents  Int     @default(0)
  allocation  Int

  soldCount Int @default(0)
  heldCount Int @default(0)

  salesStartAt DateTime?
  salesEndAt   DateTime?
  isActive     Boolean   @default(true)
  isHidden     Boolean   @default(false)

  maxPerOrder      Int     @default(10)
  maxPerEmail      Int?
  requiresApproval Boolean @default(false)

  accessLevel String      @default("GENERAL")
  level       AccessLevel @relation(fields: [accessLevel], references: [code], onUpdate: Cascade)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets    Ticket[]
  orderItems TicketOrderItem[]

  @@index([eventId, sortOrder])
  @@map("ticket_tier")
}

model TicketOrder {
  id          String @id @default(cuid())
  orderNumber String @unique

  eventId String
  event   TicketEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  status TicketOrderStatus @default(PENDING)

  buyerEmail String?
  buyerName  String?
  buyerPhone String?
  userId     String?

  subtotalCents   Int    @default(0)
  discountCents   Int    @default(0)
  bookingFeeCents Int    @default(0)
  totalCents      Int    @default(0)
  gstCents        Int    @default(0)
  gstRateBp       Int    @default(1500)
  currency        String @default("NZD")

  discountCodeId String?
  paymentMethod  PaymentMethodKind @default(STRIPE)

  stripePaymentIntentId String? @unique
  stripeChargeId        String?
  soldByUserId          String?

  termsAcceptedAt DateTime?
  termsVersion    String?
  /// Separate from the ticket purchase — UEMA 2007 needs express consent.
  marketingOptIn  Boolean   @default(false)

  accessTokenVersion Int       @default(1)
  detailsCompletedAt DateTime?

  /// Hold expiry while PENDING.
  expiresAt     DateTime?
  paidAt        DateTime?
  refundedCents Int       @default(0)
  refundedAt    DateTime?

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  ipAddress   String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       TicketOrderItem[]
  tickets     Ticket[]
  emails      TicketEmailLog[]
  redemptions DiscountRedemption[]

  @@index([eventId, status])
  @@index([buyerEmail])
  @@index([status, expiresAt])
  @@index([createdAt])
  @@map("ticket_order")
}

model TicketOrderItem {
  id             String @id @default(cuid())
  orderId        String
  tierId         String
  quantity       Int
  /// Snapshot: tier prices can change after the order is placed.
  unitPriceCents Int

  order TicketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tier  TicketTier  @relation(fields: [tierId], references: [id], onDelete: Restrict)

  @@unique([orderId, tierId])
  @@index([tierId])
  @@map("ticket_order_item")
}

model Ticket {
  id           String @id @default(cuid())
  /// ATN-4F7K2X-03
  ticketNumber String @unique

  orderId String
  eventId String
  tierId  String?

  status        TicketStatus @default(VALID)
  attendeeName  String?
  attendeeEmail String?

  accessLevel String      @default("GENERAL")
  level       AccessLevel @relation(fields: [accessLevel], references: [code], onUpdate: Cascade)

  isComp Boolean @default(false)

  nameLockedAt DateTime?

  hostTicketId  String?
  invitedByName String?
  sentAt        DateTime?

  qrSecret  String
  qrVersion Int    @default(1)

  accessTokenVersion Int @default(1)

  pricePaidCents Int @default(0)

  applePassSerial String? @unique
  googleObjectId  String? @unique

  voidedAt   DateTime?
  voidReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order      TicketOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event      TicketEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tier       TicketTier?  @relation(fields: [tierId], references: [id], onDelete: Restrict)
  hostTicket Ticket?      @relation("CompHandout", fields: [hostTicketId], references: [id], onDelete: SetNull)
  handouts   Ticket[]     @relation("CompHandout")
  scans      TicketScan[]

  @@index([eventId, status])
  @@index([orderId])
  @@index([tierId])
  @@index([eventId, isComp, status])
  @@index([hostTicketId])
  @@map("ticket")
}

/// Append-only scan log. Powers "already admitted, 14 minutes ago" on the door
/// and the arrivals curve in analytics. Never updated, never deleted.
model TicketScan {
  id       String  @id @default(cuid())
  ticketId String?
  eventId  String

  result      TicketScanResult
  wasOverride Boolean          @default(false)

  denyReason TicketDenyReason?
  denyNote   String?

  scannedByUserId String?
  deviceLabel     String?
  rawToken        String?

  createdAt DateTime @default(now())

  ticket Ticket?     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  event  TicketEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([ticketId, createdAt])
  @@index([eventId, result])
  @@map("ticket_scan")
}

model TicketEventStaff {
  id      String         @id @default(cuid())
  eventId String
  userId  String
  role    EventStaffRole @default(SCANNER)

  createdBy String?
  createdAt DateTime @default(now())

  event TicketEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("ticket_event_staff")
}

model DiscountCode {
  id   String @id @default(cuid())
  code String @unique

  type  DiscountCodeType
  value Int

  eventId String?
  event   TicketEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tierIds String[]

  maxRedemptions  Int?
  maxPerEmail     Int? @default(1)
  minTickets      Int?
  redemptionCount Int  @default(0)

  startsAt           DateTime?
  endsAt             DateTime?
  isActive           Boolean   @default(true)
  unlocksHiddenTiers Boolean   @default(false)

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions DiscountRedemption[]

  @@index([eventId, isActive])
  @@map("discount_code")
}

model DiscountRedemption {
  id          String  @id @default(cuid())
  codeId      String
  orderId     String
  email       String?
  amountCents Int

  createdAt DateTime @default(now())

  code  DiscountCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  order TicketOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([codeId, orderId])
  @@index([codeId, email])
  @@map("discount_redemption")
}

model TicketEmailLog {
  id      String          @id @default(cuid())
  orderId String?
  type    TicketEmailType
  toEmail String

  providerMessageId String?
  status            String
  error             String?

  createdAt DateTime @default(now())

  order TicketOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([createdAt])
  @@map("ticket_email_log")
}

/// Devices that have added an Apple Wallet pass, so we can push updates when an
/// event time changes or a ticket is voided.
model WalletPassRegistration {
  id                      String @id @default(cuid())
  deviceLibraryIdentifier String
  passTypeIdentifier      String
  serialNumber            String
  pushToken               String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([deviceLibraryIdentifier, serialNumber])
  @@index([serialNumber])
  @@map("wallet_pass_registration")
}
