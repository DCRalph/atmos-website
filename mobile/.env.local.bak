# Local dev override: talk to production instead of the LAN dev server.
#
# `src/lib/env.ts` reads this ahead of the Metro-host guess, so the app hits
# https://atmosmedia.co.nz for tRPC and better-auth rather than
# http://<metro-host>:3000. Gitignored via the `.env*.local` rule.
EXPO_PUBLIC_API_URL=https://atmosmedia.co.nz
